# Root environment example — local development only.
#
# The API reads its own file: copy `api/.env.example` to `api/.env` and edit that.
# Nothing here is loaded automatically; `docker-compose.yml` carries the defaults
# used by the local Postgres service.

# Local Postgres (matches docker-compose.yml)
POSTGRES_USER=aikeyboard
POSTGRES_PASSWORD=aikeyboard
POSTGRES_DB=aikeyboard

# What the API needs in api/.env
# DATABASE_URL=postgresql://aikeyboard:aikeyboard@localhost:5432/aikeyboard?schema=public
# JWT_SECRET=<32+ random bytes; never the example value in a deployed environment>

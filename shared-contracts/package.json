{
  "name": "@ai-keyboard/shared-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical OpenAPI 3.1 spec, generated types, request schemas and a typed client shared by mobile and API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./client": "./src/client.ts"
  },
  "files": [
    "openapi.yaml",
    "schemas",
    "src"
  ],
  "scripts": {
    "gen": "openapi-typescript openapi.yaml -o src/types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  }
}

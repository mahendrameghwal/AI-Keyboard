{
  "name": "ai-keyboard",
  "version": "0.1.0",
  "private": true,
  "description": "AI Keyboard — AI-powered writing assistant (monorepo: mobile app, backend API, shared contracts)",
  "workspaces": [
    "api",
    "mobile",
    "shared-contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:dev": "npm run dev --workspace api",
    "api:build": "npm run build --workspace api",
    "api:test": "npm run test --workspace api",
    "api:lint": "npm run lint --workspace api",
    "api:typecheck": "npm run typecheck --workspace api",
    "prisma:deploy": "npm run prisma:deploy --workspace api",
    "prisma:generate": "npm run prisma:generate --workspace api",
    "mobile:dev": "npm run start --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "mobile:prebuild": "npm run prebuild --workspace mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen": "npm run gen --workspace shared-contracts",
    "gen:check": "npm run gen && git diff --exit-code shared-contracts/src/types.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "body-parser": "~1.20.9"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "^5.20.0"
  }
}

// AI Keyboard — database schema (draft, per implementation-plan.md §1.2)
// PostgreSQL + Prisma. Amended from SRS §14.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deleted
}

enum Platform {
  android
  ios
}

enum DeletionJobStatus {
  pending
  processing
  completed
  failed
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  // Stored lowercased; uniqueness is enforced case-insensitively at write time.
  email        String     @unique
  passwordHash String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  sessions     Session[]
  devices      Device[]
  preferences  UserPreference?
  deletionJobs AccountDeletionJob[]
  usageEvents  UsageEvent[]

  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenFamilyId String    @db.Uuid
  // Start of the refresh-token family; bounds absolute lifetime across rotations.
  familyStartedAt DateTime @default(now())
  tokenHash     String    @unique
  deviceId      String?   @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  platform   Platform
  name       String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("devices")
}

model UserPreference {
  userId       String   @id @db.Uuid
  writingStyle String   @default("neutral")
  toneStrength String   @default("balanced")
  formality    String   @default("neutral")
  defaultLength String  @default("normal")
  language     String   @default("en-IN")
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model AccountDeletionJob {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  status       DeletionJobStatus @default(pending)
  requestedAt  DateTime          @default(now())
  scheduledFor DateTime
  attempts     Int               @default(0)
  completedAt  DateTime?
  error        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("account_deletion_jobs")
}

// Present but unused while USAGE_TRACKING_ENABLED=false (plan §0.1, D11).
// NEVER stores message text (SRS §14.7, §16.2).
model UsageEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  action       String
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  status       String
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_events")
}

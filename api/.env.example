# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
# Local docker-compose: docker compose up -d db
DATABASE_URL=postgresql://aikeyboard:aikeyboard@localhost:5432/aikeyboard?schema=public

# CORS: mobile-only client, deny all by default (comma-separated origins to allow)
CORS_ORIGINS=

# Auth (accounts are optional; used only for cloud preference sync)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=2592000
JWT_SECRET=change-me-in-production

# Rate limiting (per IP)
# Auth endpoints: RATE_LIMIT_AUTH_ATTEMPTS per RATE_LIMIT_AUTH_WINDOW_SECONDS
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GENERATE_ANON=30
RATE_LIMIT_GENERATE_AUTHED=120
RATE_LIMIT_PROVIDER_TEST=10
RATE_LIMIT_AUTH_ATTEMPTS=5

# Request limits
MAX_REQUEST_BODY_BYTES=65536
MAX_TEXT_CHARS=8000
MAX_SUMMARIZE_TEXT_CHARS=12000
MAX_CUSTOM_INSTRUCTIONS=10
MAX_CUSTOM_INSTRUCTION_CHARS=300

# Provider (upstream) request timeout
PROVIDER_TIMEOUT_MS=30000

# Model catalog (server-maintained; clients never ship model lists)
# Optional JSON file ({ "providers": [...] }) that replaces the built-in catalog.
MODEL_CATALOG_PATH=
MODEL_CATALOG_TTL_SECONDS=3600
# Kill switch: comma-separated provider ids to hide and reject.
DISABLED_PROVIDERS=

# Background jobs (expired-session pruning + scheduled account deletion)
BACKGROUND_JOBS_INTERVAL_MINUTES=60

# Feature flags
USAGE_TRACKING_ENABLED=false
STREAMING_ENABLED=false

# Providers (Local Dev & Seeding)
OPENAI_API_KEY=

# Seed User Credentials
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

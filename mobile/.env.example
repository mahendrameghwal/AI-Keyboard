# Read by Expo when bundling (EXPO_PUBLIC_* is inlined into the JS bundle).
# Never put a provider key or any secret here — EXPO_PUBLIC_* values ship inside the app.
#
# This file is git-ignored when copied to .env, and EAS builds upload only tracked files, so
# a cloud build never sees it. The value a shipped build uses lives in app.json#extra.apiBaseUrl;
# this override exists for local development against the local api workspace.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
